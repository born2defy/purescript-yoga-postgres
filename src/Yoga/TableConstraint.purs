  )

tryParse :: forall @string wordList cleanstring 
   . IsSymbol string
  => TrimStart string cleanstring
  => ParseText cleanstring wordList
  => PrintSList wordList
  => String
tryParse = parseTextToList @string 


tryValidParse :: forall string wordList cleanstring rows
   . IsSymbol string
  => ValidateFields wordList rows
  => TrimStart string cleanstring
  => ParseText cleanstring wordList
  => PrintSList wordList
  => Proxy rows
  -> Proxy string
  -> String
tryValidParse p s = parseTextToListValidated p s

class ParseText (string :: Symbol) (wordList :: SList) | string -> wordList
class ParseCharacter (head :: Symbol) (tail :: Symbol) (wordList :: SList) | head tail -> wordList

instance ParseText "" (SCons "" SNil)
else instance 
  ( Symbol.Cons head tail string
  , ParseCharacter head tail wordList
  ) => ParseText string wordList

-- | Skip ending commas, spaces, and periods
instance ParseCharacter "," "" (SCons "" SNil)
else instance ParseCharacter " " "" (SCons "" SNil)
else instance ParseCharacter "." "" (SCons "" SNil)
else instance ParseCharacter char "" (SCons char SNil)
else instance 
  ( Symbol.Cons head tail string
  , ParseText tail rest
  ) =>  ParseCharacter "," string (SCons "" rest)

-- | Skip spaces
else instance ParseText tail rest =>  ParseCharacter " " tail rest

else instance 
  ( ParseText tail (SCons acc rest)
  , Symbol.Cons head acc acc2
  ) => ParseCharacter head tail (SCons acc2 rest)  

-- Skip leading spaces
class TrimStart :: Symbol -> Symbol -> Constraint
class TrimStart sym result | sym -> result

instance TrimStart "" ""
else instance
  ( Symbol.Cons head tail sym
  , TrimStartGo head tail result
  ) => TrimStart sym result

class TrimStartGo :: Symbol -> Symbol -> Symbol -> Constraint
class TrimStartGo head tail result | head tail -> result

instance TrimStart tail result => TrimStartGo " " tail result
else instance TrimStart tail result => TrimStartGo "," tail result
else instance Symbol.Cons head tail result => TrimStartGo head tail result

trimStart :: forall @string skipped
    . IsSymbol skipped
   => TrimStart string skipped
   => String
trimStart = reflectSymbol (Proxy @skipped)

try1 :: String
try1 = trimStart @"hell,oworld "

try2 :: String
try2 = trimStart @",hell oworld "

try3 :: String
try3 = trimStart @"  ,,  hell oworld "

allEqual :: forall a. Eq a => Array a -> Boolean
allEqual arr = case uncons arr of
  Nothing -> false 
  Just { head, tail } -> all (_ == head) tail



-- | Remove interior double spaces
class NoDoubleSpaces (input :: Symbol) (output :: Symbol) | input -> output

instance noDoubleSpacesEmpty :: NoDoubleSpaces "" ""
else instance noDoubleSpacesStep :: 
  ( Symbol.Cons head tail input
  , HandleSpace head tail output
  ) => NoDoubleSpaces input output

class HandleSpace (head :: Symbol) (tail :: Symbol) (output :: Symbol) | head tail -> output
instance handleLastSpace :: HandleSpace " " "" ""

else instance handleDoubleSpace :: 
  ( NoDoubleSpaces tail acc
  , Symbol.Append newhead acc result
  , WithSpace " " next newhead
  , Symbol.Cons next rest tail 
  ) => HandleSpace " " tail result

else instance handleSpaceStep :: 
  ( NoDoubleSpaces tail acc
  , Symbol.Cons head acc result
  ) => HandleSpace head tail result

class WithSpace (input :: Symbol) (next :: Symbol) (output :: Symbol) | input next -> output
instance WithSpace " " " " ""
else instance WithSpace input next input

stripDoubleSpaces :: forall @string stripped
   . IsSymbol string
  => IsSymbol stripped   
  => NoDoubleSpaces string stripped
  => String
stripDoubleSpaces = reflectSymbol (Proxy @stripped)

trySpaces = stripDoubleSpaces @P6

--| Trim Trailing Space
-- | Removes trailing spaces, tabs, and newlines from a Symbol
class TrimEnd (input :: Symbol) (output :: Symbol) | input -> output

instance trimEndEmpty :: TrimEnd "" ""
else instance trimEndStep ::
  ( Symbol.Cons head tail input
  , TrimEnd tail trimmedTail
  , HandleChar head trimmedTail output
  ) => TrimEnd input output

-- | Helper class to drop the character if the rest of the string became empty
class HandleChar (head :: Symbol) (tail :: Symbol) (output :: Symbol) | head tail -> output

instance      dropSpace   :: HandleChar " " "" ""
else instance dropTab     :: HandleChar "\t" "" ""
else instance dropNewline :: HandleChar "\n" "" ""
else instance dropCR      :: HandleChar "\r" "" ""
else instance dropComma   :: HandleChar "," "" ""
else instance dropPeriod  :: HandleChar "." "" ""
else instance keepChar    :: Symbol.Append head tail output => HandleChar head tail output

trimTrailingGarbage :: forall @string trimmed
   . IsSymbol string
  => IsSymbol trimmed   
  => TrimEnd string trimmed
  => String
trimTrailingGarbage = reflectSymbol (Proxy @trimmed)

cleanString :: forall @string endtrimmed alltrimmed cleaned
   . IsSymbol string
  => IsSymbol endtrimmed
  => IsSymbol alltrimmed  
  => IsSymbol cleaned
  => NoDoubleSpaces alltrimmed cleaned
  => TrimStart endtrimmed alltrimmed
  => TrimEnd string endtrimmed
  => String
cleanString = reflectSymbol (Proxy @cleaned)


